# Copy to e2e/.env and fill in real values.

MOBILE_BASE_URL=
ADMIN_BASE_URL=
# Backend API — used only to delete events tests create, as cleanup.
API_BASE_URL=

ADMIN_EMAIL=
ADMIN_PASSWORD=

# A pre-existing, already-verified alumnus account (registration needs
# manual admin verification, so most tests log in as this account instead).
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=

# Used only when a test registers a brand-new throwaway account.
TEST_USER_PASSWORD=E2eTest#12345
TEST_EMAIL_DOMAIN=innopolis.university

# Timeouts (ms)
DEFAULT_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
MAP_LOAD_TIMEOUT_MS=5000
